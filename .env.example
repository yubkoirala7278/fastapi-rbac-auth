# DB_CONNECTION=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@host.docker.internal:<DB_PORT>/<DB_NAME>
DB_CONNECTION=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
JWT_SECRET="YOUR_SECRET_KEY"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_DELTA=900 
REFRESH_TOKEN_EXPIRATION_DELTA=604800